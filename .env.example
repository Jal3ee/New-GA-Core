# ====================================================================
# GA CORE - POSTGRESQL 16 ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Pilihan Mode Koneksi: 'transaction' | 'session' | 'direct'
# - transaction : Transaction Pooler (Port 6543 / PgBouncer) -> PALING BAGUS untuk web harian
# - session     : Session Pooler (Port 5432)
# - direct      : Direct Session (Port 5432 Direct Engine) -> Digunakan saat migrasi DDL skema
POSTGRES_MODE=transaction

# 2. Connection Strings (Salin dari dashboard penyedia PostgreSQL Anda)
DATABASE_URL=postgres://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require
DATABASE_URL_TRANSACTION=postgres://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require
DATABASE_URL_SESSION=postgres://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DATABASE_URL_DIRECT=postgres://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# 3. Atau gunakan parameter terpisah:
DB_HOST=localhost
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSL=true

# 4. Backend API Server & Client Port
SERVER_PORT=3001
VITE_PG_API_URL=http://localhost:3001/api

# 5. Legacy Google Apps Script (Fallback Opsional)
VITE_GAS_URL="https://script.google.com/macros/s/AKfycbxRsV4JE1c63MNx3gC4UePMQk45ZkbrMzyzpd0FDGkzrY_kp9THWjzmrASednGzzQpw_g/exec"
VITE_API_SECRET="base_secret_123"
VITE_SESSION_SALT="pepper_rahasia"
